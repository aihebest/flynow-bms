# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-app.azurestaticapps.net

# ─── Azure PostgreSQL ──────────────────────────────────────────────────────────
DB_HOST=flynowtravels-db.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flynow_bms
DB_USER=flynowadmin
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSL=true

# ─── Azure Entra ID (JWT validation) ──────────────────────────────────────────
AZURE_TENANT_ID=YOUR_TENANT_ID
JWT_AUDIENCE=api://YOUR_BACKEND_APP_CLIENT_ID
JWKS_URI=https://login.microsoftonline.com/YOUR_TENANT_ID/discovery/v2.0/keys

# ─── Microsoft Graph API (SharePoint + Outlook) ────────────────────────────────
GRAPH_TENANT_ID=YOUR_TENANT_ID
GRAPH_CLIENT_ID=YOUR_GRAPH_APP_CLIENT_ID
GRAPH_CLIENT_SECRET=YOUR_GRAPH_APP_CLIENT_SECRET
SHAREPOINT_SITE_ID=flynowtravels.sharepoint.com,YOUR_SITE_ID,YOUR_WEB_ID
SHAREPOINT_CUSTOMER_DOCS_DRIVE_ID=YOUR_DRIVE_ID
OUTLOOK_SENDER_EMAIL=noreply@flynowtravels.com

# ─── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY

# ─── Zoho Books ────────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=YOUR_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=YOUR_ZOHO_CLIENT_SECRET
ZOHO_REFRESH_TOKEN=YOUR_ZOHO_REFRESH_TOKEN
ZOHO_ORGANIZATION_ID=YOUR_ZOHO_ORG_ID

# ─── Teams Webhooks (optional — for notifications) ─────────────────────────────
TEAMS_BOOKINGS_WEBHOOK=
TEAMS_VISA_WEBHOOK=
TEAMS_FINANCE_WEBHOOK=
TEAMS_HR_WEBHOOK=
TEAMS_MANAGEMENT_WEBHOOK=
